# ==============================================================================
# MECT STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Mahaveer Educational & Charitable Trust (https://staging.mect.org.in)
# ==============================================================================

# Active Spring Profile (Enforces staging isolation)
SPRING_PROFILES_ACTIVE=staging

# Database Settings (Dedicated Isolated Staging Container on private internal network)
# Zero host ports published; accessible solely via mect-staging-network
DB_HOST=mect-postgres-staging
DB_PORT=5432
DB_NAME=mect_staging_db
DB_USERNAME=mect_staging_user
DB_PASSWORD=generate_a_strong_random_staging_db_password_min_32_chars

# Staging Authentication & JWT
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://staging.mect.org.in,https://staging-api.mect.org.in
JWT_SECRET=generate_a_random_staging_jwt_secret_min_256_bits_long
JWT_ACCESS_VALIDITY=900
JWT_REFRESH_VALIDITY=604800
OTP_HASH_PEPPER=generate_a_random_staging_otp_hash_pepper_string
OTP_DETERMINISTIC_TEST_ENABLED=true
OTP_DETERMINISTIC_TEST_CODE=123456
APP_PUBLIC_BASE_URL=https://staging.mect.org.in

# Google OIDC Sign-In (Staging GIS Credential Flow: JavaScript Origin Only)
GOOGLE_CLIENT_ID=your_staging_google_oauth_client_id_here.apps.googleusercontent.com

# Email Notifications (Optional for Staging / Mock Fallback)
RESEND_API_KEY=
RESEND_FROM_NOTIFICATIONS=MECT Staging Notifications <notifications@mect.org.in>
RESEND_FROM_DONATIONS=MECT Staging Donations <donations@mect.org.in>

# SMS Provider (Staging Mock Mode — Outbound carrier SMS disabled, secure mock logging)
SMS_PROVIDER=MOCK

# Payment Gateway (Strict Staging Sandbox Mode)
PAYMENT_PROVIDER=CASHFREE
PAYMENT_SANDBOX_MODE=true
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_RETURN_URL=https://staging.mect.org.in/donate?order_id={order_id}
CASHFREE_NOTIFY_URL=https://staging-api.mect.org.in/api/v1/webhooks/payments/cashfree

# WhatsApp Notifications (Strictly Disabled in Staging)
WHATSAPP_ENABLED=false

# AI Chat Engine (Staging Mode)
AI_ENGINE_MODE=local_with_fallback
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ==============================================================================
# MAHAVIR TRUST (MECT) - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to `.env.local` for local frontend development or `.env` for production.
# 2. Every variable is accompanied by a one-line explanation.
# 3. DO NOT commit actual passwords, private keys, or API tokens to git.

# ------------------------------------------------------------------------------
# 1. Frontend & Client Feature Flags (Next.js)
# ------------------------------------------------------------------------------
# Flag to enable the experimental community Odia language switcher (true/false; default false until Trust review).
NEXT_PUBLIC_ENABLE_ODIA=false

# Public base URL for the backend Spring Boot REST API accessed from browser clients.
NEXT_PUBLIC_API_BASE_URL=https://mect.org.in/api/v1

# Secondary alias for public backend API URL used by client-side portal components.
NEXT_PUBLIC_API_URL=https://mect.org.in/api/v1

# ------------------------------------------------------------------------------
# 2. Server-Side Reverse Proxy & Networking
# ------------------------------------------------------------------------------
# Upstream HTTP URL for Next.js server-side route proxies connecting to Spring Boot.
# In Docker Compose (containerized frontend): use http://mect-backend:8080 (internal Docker bridge network).
# In host-local development (Next.js on host, backend container mapped): use http://127.0.0.1:8081.
BACKEND_API_URL=http://mect-backend:8080

# Development Fallback Flag: when true AND NODE_ENV !== 'production', allows simulated local ticket references when backend is offline.
ALLOW_DEV_FALLBACK=false

# Trusted reverse proxy header providing verified client IP (X-Forwarded-For or X-Real-IP).
TRUSTED_PROXY_HEADER=X-Forwarded-For

# Node.js runtime environment mode (development, test, or production).
NODE_ENV=production

# Local port on which the Next.js server listens (default: 3000).
PORT=3000

# Network interface address binding for Next.js HTTP server (0.0.0.0 for container, 127.0.0.1 for host).
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 3. Database Settings (PostgreSQL 18)
# ------------------------------------------------------------------------------
# Hostname or Docker compose service name for PostgreSQL database (e.g. mect-postgres or 127.0.0.1).
DB_HOST=mect-postgres

# Network port for PostgreSQL database connection (default: 5432 internal, 5433 host-mapped).
DB_PORT=5432

# Name of the PostgreSQL database for MECT application data (e.g. mect_db).
DB_NAME=mect_db

# PostgreSQL database username for application access.
DB_USERNAME=mect_user

# PostgreSQL database password for application user authentication.
DB_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 4. Backend Application Settings (Spring Boot)
# ------------------------------------------------------------------------------
# Internal server port for Spring Boot application inside its container (default: 8080).
SERVER_PORT=8080

# Comma-separated allowed HTTP origins for backend Cross-Origin Resource Sharing (CORS).
CORS_ALLOWED_ORIGINS=https://mect.org.in,https://www.mect.org.in

# Public canonical base URL of the MECT web platform.
APP_PUBLIC_BASE_URL=https://mect.org.in

# High-entropy cryptographic secret for signing and verifying donor portal JWT tokens (min 256 bits).
JWT_SECRET=your_jwt_hmac_sha256_secret_key_minimum_32_characters_long

# Expiration period in seconds for donor portal access tokens (default: 900 = 15 minutes).
JWT_ACCESS_VALIDITY=900

# Expiration period in seconds for donor portal refresh tokens (default: 604800 = 7 days).
JWT_REFRESH_VALIDITY=604800

# Secret cryptographic pepper combined with OTP codes before hashing for storage.
OTP_HASH_PEPPER=your_cryptographic_otp_pepper_string_here

# ------------------------------------------------------------------------------
# 5. Banking & Payment Configuration (No Online Gateway; SBI Direct Transfer Only)
# ------------------------------------------------------------------------------
# Active payment provider mode (set to SBI_DIRECT for direct bank transfer and UPI).
PAYMENT_PROVIDER=SBI_DIRECT

# Sandbox simulation flag (false for production live banking coordination).
PAYMENT_SANDBOX_MODE=false

# ------------------------------------------------------------------------------
# 6. Email Delivery & Secretariat Notification (Optional Transactional Service)
# ------------------------------------------------------------------------------
# API key for transactional email deliveries via Resend (leave blank if offline).
RESEND_API_KEY=

# From-address header for administrative system alerts and inquiries.
RESEND_FROM_NOTIFICATIONS=MECT Notifications <notifications@mect.org.in>

# From-address header for donor reconciliation and receipt communications.
RESEND_FROM_DONATIONS=MECT Donations <donations@mect.org.in>

# SMTP Configuration (Standard JavaMailSender / SMTP delivery)
# When configured, notifies Secretariat of new donation claims and public inquiries.
# Left empty by default; feature switches on only when SMTP_HOST and SMTP_USERNAME are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SECRETARIAT_NOTIFICATION_EMAIL=mect220@gmail.com

# ------------------------------------------------------------------------------
# 7. AI Gateway Architecture (Ask MECT Chatbot)
# ------------------------------------------------------------------------------
# Execution mode for Ask MECT chatbot (local_with_fallback, local_only, or cloud_only).
AI_ENGINE_MODE=local_with_fallback

# Upstream URL for local Python AI inference engine chat completions endpoint.
LOCAL_AI_CHAT_URL=http://127.0.0.1:8082/v1/chat/completions

# Healthcheck probe endpoint for local Python AI inference engine.
LOCAL_AI_HEALTH_URL=http://127.0.0.1:8082/v1/health

# Pre-shared authentication secret shared between Next.js server and Python AI engine.
INTERNAL_AI_SECRET=your_high_entropy_internal_secret_here_min_32_chars

# API key for cloud standby LLM inference fallback (Groq Cloud; keep empty if disabled).
GROQ_API_KEY=

# Model identifier for cloud standby LLM inference fallback.
GROQ_MODEL=qwen/qwen3.8-27b

# MAHAVIR TRUST - Backend Environment Template (Example)
# Copy this file to .env or export the variables in your local environment.
# DO NOT commit real production passwords or credentials.

SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mahavir_trust_dev
DB_USERNAME=mahavir_app
DB_USER=mahavir_app
DB_PASSWORD=your_secure_password_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment Gateway Configuration (Cashfree + Razorpay fallback)
# Obtain Cashfree credentials securely from Cashfree Merchant Dashboard -> Payment Gateway -> Developers -> API Keys
# Keep PAYMENT_PROVIDER=RAZORPAY during infrastructure deployment until explicitly authorized to activate CASHFREE
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_SANDBOX_MODE=false
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_WEBHOOK_TOLERANCE_SECONDS=300
CASHFREE_RETURN_URL=http://localhost:3000/donate?order_id={order_id}
CASHFREE_NOTIFY_URL=https://mect.org.in/api/v1/webhooks/payments/cashfree

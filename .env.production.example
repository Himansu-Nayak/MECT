# ==============================================================================
# MECT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Mahaveer Educational & Charitable Trust (https://mect.org.in)
# ==============================================================================

# Database Settings (MECT PostgreSQL Docker Container)
DB_HOST=mect-postgres
DB_PORT=5432
DB_NAME=mect_db
DB_USERNAME=mect_user
DB_PASSWORD=your_strong_production_database_password_here

# Backend Server & Authentication
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://mect.org.in,https://www.mect.org.in
JWT_SECRET=your_production_jwt_secret_min_256_bits_long
JWT_ACCESS_VALIDITY=900
JWT_REFRESH_VALIDITY=604800
OTP_HASH_PEPPER=your_production_otp_hash_pepper_string
APP_PUBLIC_BASE_URL=https://mect.org.in

# Email Notifications (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_NOTIFICATIONS=MECT Notifications <notifications@mect.org.in>
RESEND_FROM_DONATIONS=MECT Donations <donations@mect.org.in>
RESEND_WEBHOOK_SECRET=

# Payment Gateway Configuration (Cashfree Production)
PAYMENT_PROVIDER=CASHFREE
PAYMENT_SANDBOX_MODE=false
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01
CASHFREE_APP_ID=your_cashfree_production_app_id
CASHFREE_SECRET_KEY=your_cashfree_production_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_production_webhook_secret
CASHFREE_WEBHOOK_TOLERANCE_SECONDS=300
CASHFREE_RETURN_URL=https://mect.org.in/donate?order_id={order_id}
CASHFREE_NOTIFY_URL=https://mect.org.in/api/v1/webhooks/payments/cashfree

# Frontend AI Engine Settings (Groq Cloud)
AI_ENGINE_MODE=local_with_fallback
GROQ_API_KEY=gsk_your_groq_production_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

